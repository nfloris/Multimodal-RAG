# -----------------------------------------------------------------------------
# WSL HUGGING FACE CACHE
# These settings are ignored during native Windows runs. Change
# WSL_WINDOWS_HF_HOME when the Windows cache is mounted elsewhere in WSL.
# -----------------------------------------------------------------------------

WSL_WINDOWS_HF_HOME=/mnt/c/Users/danie/.cache/huggingface
# MULTIRAG_FORCE_WSL_HF_CACHE=true
# MULTIRAG_HF_OFFLINE=true

# -----------------------------------------------------------------------------
# CHUNKING
# CHUNKING_STRATEGY: "by_title" (structure-aware) | "basic" (fixed-size)
# MAX_CHARACTERS:    hard cap per chunk (characters)
# NEW_AFTER_N:       soft target chunk size â€” new chunk starts after this
# COMBINE_UNDER_N:   merge short blocks (< N chars) with the previous chunk
# TABLES_AS_IMAGES:  "true" = extract tables as images via hi_res pipeline
#                    "false" = treat table content as plain text
# -----------------------------------------------------------------------------

CHUNKING_STRATEGY=by_title
MAX_CHARACTERS=3000
NEW_AFTER_N=2000
COMBINE_UNDER_N=500
TABLES_AS_IMAGES=true


# -----------------------------------------------------------------------------
# TEXT SUMMARIZATION MODEL (Groq)
# Free tier models (rate-limited):
#   llama-3.1-8b-instant          â€” fast, lower quality
#   llama-3.3-70b-versatile       â€” slower, higher quality (recommended)
#   llama-3.1-70b-versatile       â€” alternative 70B
# -----------------------------------------------------------------------------

TEXT_SUMMARY_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# TEXT_SUMMARY_MODEL=llama-3.3-70b-versatile
#
# -----------------------------------------------------------------------------
# IMAGE SUMMARIZATION MODEL (local HuggingFace â€” requires GPU / enough RAM)
#   Qwen/Qwen2.5-VL-3B-Instruct   â€” recommended balance (~8 GB VRAM)
#   Qwen/Qwen2-VL-2B-Instruct     â€” lighter legacy option (~6 GB VRAM)
#   Qwen/Qwen2-VL-7B-Instruct     â€” higher quality (~16 GB VRAM)
# MAX_IMAGE_SUMMARIZATION_LIMIT:  cap on images processed per run
#                                 (set to a small number, e.g. 3, for quick tests)
# -----------------------------------------------------------------------------

IMAGE_SUMMARY_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# IMAGE_SUMMARY_MODEL=Qwen/Qwen2-VL-2B-Instruct
# IMAGE_SUMMARY_MODEL=Qwen/Qwen2-VL-7B-Instruct

MAX_IMAGE_SUMMARIZATION_LIMIT=999


# -----------------------------------------------------------------------------
# EMBEDDING MODEL (local HuggingFace)
#   BAAI/bge-m3                                â€” recommended (1024-dim, multilingual)
#   nomic-ai/nomic-embed-text-v1               â€” long-context alternative (768-dim)
#   sentence-transformers/all-MiniLM-L6-v2    â€” fast baseline (384-dim)
#
# NOTE: changing this after indexing requires re-indexing from scratch,
# because vector dimensions must match the AstraDB collection schema.
# -----------------------------------------------------------------------------

EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# -----------------------------------------------------------------------------
# RETRIEVAL
# RETRIEVER_K:    number of candidate documents fetched before reranking
# RERANKER_TOP_N: documents kept after reranking (must be <= RETRIEVER_K)
# RERANKER_MODEL: HuggingFace cross-encoder model
# ENABLE_BM25:    "true" | "false" â€” add sparse BM25 retrieval to the pipeline
# ENABLE_RERANKING: "true" | "false" â€” apply cross-encoder reranking
# -----------------------------------------------------------------------------

RETRIEVER_K=10
RERANKER_TOP_N=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_BM25=true
ENABLE_RERANKING=true


# -----------------------------------------------------------------------------
# GENERATION MODEL (Groq â€” multimodal)
#   meta-llama/llama-4-scout-17b-16e-instruct      â€” default, multimodal free tier
#   meta-llama/llama-4-maverick-17b-128e-instruct  â€” alternative multimodal
#   llama-3.3-70b-versatile                        â€” text-only, stronger reasoning
# -----------------------------------------------------------------------------

# GENERATION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GENERATION_MODEL=mistral-nemo:latest
# GENERATION_MODEL=qwen2.5:7b-instruct
GENERATION_BACKEND=ollama
# Optional. Uncomment to force Ollama CPU/GPU layer behavior, for example 0 for CPU-only.
# OLLAMA_NUM_GPU=0
# GENERATION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
# GENERATION_MODEL=llama-3.3-70b-versatile
